* {
    /* claude-inspired yazi flavor: rapidrabbit76/claude-inspired */
    bg:     rgba(23, 20, 18, 0.8);
    bg-alt: rgba(36, 33, 31, 0.8);
    fg:     #FEF3C7;
    fg-alt: #9C9793;
    accent: #C76A4F;
    urgent: #B44F5F;
    border: #3C3835;
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    padding: 12px;
}

mainbox {
    background-color: transparent;
}

inputbar {
    background-color: transparent;
    text-color: @fg;
    children: [ prompt, entry ];
    padding: 8px;
    border: 0px 0px 1px 0px;
    border-color: @border;
}

prompt {
    background-color: transparent;
    text-color: @accent;
    padding: 0px 8px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search";
    placeholder-color: @fg-alt;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 10;
    spacing: 6px;
    padding: 8px 0px 0px 0px;
}

element {
    background-color: @bg-alt;
    text-color: @fg;
    border-radius: 8px;
    padding: 6px 10px;
}

element selected {
    background-color: @accent;
    text-color: @fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 1em;
}
