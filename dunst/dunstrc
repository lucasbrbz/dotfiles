[global]
    monitor = 0
    follow = none
    width = (200, 350)
    height = 300
    origin = bottom-right
    offset = 20x60

    transparency = 15
    corner_radius = 10

    frame_width = 2
    frame_color = "#e95420"

    font = Ubuntu 11

    background = "#000000"
    foreground = "#ffffff"

    separator_height = 2
    separator_color = frame

    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10

    icon_position = left
    max_icon_size = 32

    markup = full
    format = "<b>%s</b>\n%b"
    word_wrap = yes
    ellipsize = middle

    line_height = 2
    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_age_threshold = 60
    show_indicators = yes

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    mouse_left_button = close_current
    mouse_right_button = close_all
    mouse_middle_button = do_action

    dmenu = /usr/bin/rofi -dmenu -i -p dunst
    browser = /usr/bin/xdg-open

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 6

[urgency_critical]
    background = "#c01c28"
    foreground = "#ffffff"
    frame_color = "#c01c28"
    timeout = 0
