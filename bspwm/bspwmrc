#!/usr/bin/env bash

# colors
BG_COLOR="#000000"
INACTIVE_BG_COLOR="#000000"
TEXT_COLOR="#ffffff"
INACTIVE_TEXT_COLOR="#aea79f"
URGENT_BG_COLOR="#c01c28"
WS_BG_COLOR="#e95420"

WALLPAPER="/usr/share/backgrounds/warty-final-ubuntu.png"

# reapply whatever layout was last active this session (e.g. a bspc wm -r to
# fix picom glitches shouldn't undo your monitor setup); falls back to
# laptop-only on a fresh login, since the state file is cleared on logout/reboot
sleep 0.5
LAYOUT_STATE="${XDG_RUNTIME_DIR:-/tmp}/screenlayout-current"
LAYOUT_SCRIPT="$HOME/.screenlayout/$(cat "$LAYOUT_STATE" 2>/dev/null || echo laptop).sh"
[ -x "$LAYOUT_SCRIPT" ] || LAYOUT_SCRIPT="$HOME/.screenlayout/laptop.sh"
"$LAYOUT_SCRIPT"

# fix mouse pointer
xsetroot -cursor_name left_ptr &

# basic settings
bspc config border_width         2
bspc config window_gap           10
bspc config top_padding          10
bspc config right_padding        10
bspc config left_padding         10
bspc config bottom_padding       10

bspc config split_ratio               0.50
bspc config borderless_monocle        true
bspc config gapless_monocle           true
bspc config focus_follows_pointer     false
bspc config pointer_follows_focus     true
bspc config pointer_follows_monitor   true
bspc config click_to_focus            button1
bspc config remove_disabled_monitors  true
bspc config remove_unplugged_monitors true
bspc config ignore_ewmh_focus         true

# window colors
bspc config normal_border_color   "$INACTIVE_BG_COLOR"
bspc config active_border_color   "$INACTIVE_BG_COLOR"
bspc config focused_border_color  "$WS_BG_COLOR"
bspc config presel_feedback_color "$WS_BG_COLOR"

# services
# keyboard daemon
pkill -x sxhkd 2>/dev/null
sxhkd -c "$HOME/.config/sxhkd/sxhkdrc" &
# compositor
pkill -x picom 2>/dev/null
picom &
# notifications
pkill -x dunst 2>/dev/null
dunst &

# wallpaper
feh --bg-fill "$WALLPAPER" &

# rules: general
bspc rule -a '*' border=on
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

# scratchpads

bspc rule -a scratchpad-term state=floating sticky=on layer=above hidden=off rectangle=1200x700+360+120 center=on
bspc rule -a scratchpad-yazi state=floating sticky=on layer=above hidden=off rectangle=1400x800+260+80 center=on

# app assignments

bspc rule -a Alacritty desktop='^1' follow=on
bspc rule -a Brave-browser desktop='^2' follow=on
bspc rule -a Emacs desktop='^3' follow=on
bspc rule -a Code desktop='^3' follow=on
bspc rule -a 'Brave-browser:crx_eoficlgicibekocmfdomjbfnjmehnhcd' desktop='^4' follow=on
bspc rule -a Slack desktop='^4' follow=on
bspc rule -a ZapZap desktop='^9' follow=on
bspc rule -a Spotify desktop='^10' follow=on

